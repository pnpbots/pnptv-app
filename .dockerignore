# ===========================================
# .dockerignore — PNPtv Backend Docker Build
# ===========================================

# Version control
.git
.gitignore

# Root node_modules (installed fresh in Docker)
node_modules

# Frontend app (built separately, served by nginx)
apps/web

# Infrastructure & config (mounted as volumes or used on host only)
infrastructure
config
settings
docker-compose*.yml
Dockerfile*

# Environment files (passed via docker-compose env_file)
.env
.env.*

# Host-side scripts
scripts/*.sh

# Logs & temp files
logs
tmp
temp
*.log

# Build artifacts & caches
.cache
coverage
dist

# Documentation & project files (root level only)
*.md
logo-final.png

# User uploads (mounted as volume, not needed in image)
public/uploads

# Backups & misc
backups
*.backup*
ecosystem.config.js
test-avatar-upload.js

# Editor, IDE & OS files
.claude
.vscode
.idea
.DS_Store
Thumbs.db
