BOT_TOKEN=__GENERATE_ME__
BOT_USERNAME=PNPLatinoTV_bot
BOT_NAME=Easy Bot

BOT_WEBHOOK_DOMAIN=https://pnptv.app
CHECKOUT_DOMAIN=https://easybots.store
BOT_WEBHOOK_PATH=/webhook/telegram
EPAYCO_WEBHOOK_PATH=/api/webhooks/epayco
# (Daimo webhook path retired)

ADMIN_USER_IDS=__GENERATE_ME__
ADMIN_ID=__GENERATE_ME__
ADMIN_IDS=__GENERATE_ME__

PRIME_CHANNEL_ID=__GENERATE_ME__
GROUP_ID=__GENERATE_ME__
WALL_OF_FAME_TOPIC_ID=__GENERATE_ME__
GENERAL_TOPIC_ID=__GENERATE_ME__
NOTIFICATIONS_TOPIC_ID=__GENERATE_ME__

NODE_ENV=production
PORT=3001
NODE_OPTIONS=--dns-result-order=ipv4first

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=__GENERATE_ME__
POSTGRES_USER=__GENERATE_ME__
POSTGRES_PASSWORD=__GENERATE_ME__
POSTGRES_SSL=false
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT=10000
POSTGRES_CONNECTION_TIMEOUT=5000
POSTGRES_MAX_USES=5000
POSTGRES_QUERY_CACHE_ENABLED=true
POSTGRES_QUERY_CACHE_TTL=120
POSTGRES_QUERY_CACHE_MAX_SIZE=2000

DATABASE_URL=postgresql://__GENERATE_ME__:__GENERATE_ME__@localhost:5432/__GENERATE_ME__

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300
REDIS_KEY_PREFIX=pnptv:

SENTRY_DSN=__GENERATE_ME__
SENTRY_ENVIRONMENT=production

# ePayco Payment Gateway
EPAYCO_PUBLIC_KEY=YOUR_EPAYCO_PUBLIC_KEY
EPAYCO_PRIVATE_KEY=YOUR_EPAYCO_PRIVATE_KEY
EPAYCO_P_CUST_ID=YOUR_EPAYCO_CUSTOMER_ID
EPAYCO_P_KEY=YOUR_EPAYCO_P_KEY
EPAYCO_TEST_MODE=false
EPAYCO_WEBHOOK_DOMAIN=https://pnptv.app
EPAYCO_USD_TO_COP=4000
# EPAYCO_REQUIRE_HMAC=true  # Set to true once ePayco sends x-signature headers

# Fraud detection — set to "true" to BLOCK flagged charges. Default (unset/false)
# runs all checks in shadow mode: signals are logged + persisted to fraud_flags
# but the charge proceeds. Flip to true after reviewing logs for false positives.
FRAUD_DETECTION_ENFORCE=false

# Daimo Pay retired. Crypto checkout now runs on Dash via BTCPay Server
# (see BTCPAY_URL / BTCPAY_API_KEY / BTCPAY_STORE_ID / BTCPAY_WEBHOOK_SECRET).

GROK_API_KEY=YOUR_GROK_API_KEY
GROK_MODEL=grok-3

SENDGRID_API_KEY=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=__GENERATE_ME__
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_SECURE=false
EMAIL_FROM=support@pnptv.app

EASYBOTS_SMTP_HOST=smtp.hostinger.com
EASYBOTS_SMTP_PORT=587
EASYBOTS_SMTP_SECURE=false
EASYBOTS_SMTP_USER=__GENERATE_ME__
EASYBOTS_SMTP_PASS=YOUR_EASYBOTS_SMTP_PASSWORD
EASYBOTS_FROM_EMAIL=noreply@easybots.store

PNPTV_SMTP_HOST=smtp.hostinger.com
PNPTV_SMTP_PORT=587
PNPTV_SMTP_SECURE=false
PNPTV_SMTP_USER=__GENERATE_ME__
PNPTV_SMTP_PASS=YOUR_PNPTV_SMTP_PASSWORD
PNPTV_FROM_EMAIL=noreply@pnptv.app

AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=__GENERATE_ME__

JWT_SECRET=__GENERATE_ME__
ENCRYPTION_KEY=__GENERATE_ME__

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
SESSION_TTL=86400
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

GEOCODER_PROVIDER=google
GEOCODER_API_KEY=

SUPPORT_GROUP_NAME=Support Group
SUPPORT_GROUP_ID=__GENERATE_ME__

ENABLE_CRON=true
SUBSCRIPTION_CHECK_CRON=0 0 * * *
REMINDER_3DAY_CRON=0 10 * * *
REMINDER_1DAY_CRON=0 10 * * *
PAYMENT_RECOVERY_CRON=0 */2 * * *
PAYMENT_CLEANUP_CRON=0 0 * * *

JAAS_APP_ID=__GENERATE_ME__
JAAS_API_KEY_ID=__GENERATE_ME__
JAAS_PRIVATE_KEY_PATH=./config/jaas-private-key.pem

FACE_API_KEY=YOUR_FACE_API_KEY
FACE_API_SECRET=YOUR_FACE_API_SECRET

HANGOUTS_WEB_APP_URL=https://pnptv.app/hangouts
MAIN_ROOM_COUNT=10
MAX_CALL_PARTICIPANTS=50
MAX_ROOM_PARTICIPANTS=100
WEBINAR_MAX_ATTENDEES=500

GITHUB_TOKEN=YOUR_GITHUB_TOKEN

JITSI_DOMAIN=meet.jit.si
JITSI_MUC_DOMAIN=conference.jit.si

TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_CONSUMER_KEY=YOUR_TWITTER_CONSUMER_KEY
TWITTER_CONSUMER_SECRET=YOUR_TWITTER_CONSUMER_SECRET
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN
TWITTER_CLIENT_ID=YOUR_TWITTER_CLIENT_ID
TWITTER_CLIENT_SECRET=YOUR_TWITTER_CLIENT_SECRET
TWITTER_REDIRECT_URI=https://clickera.app/api/auth/x/callback
TWITTER_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_TOKEN_SECRET=YOUR_TWITTER_ACCESS_TOKEN_SECRET
TWITTER_ACCESS_SECRET=YOUR_TWITTER_ACCESS_SECRET


# Agent server shared secret (generate with: openssl rand -hex 32)
AGENT_SHARED_SECRET=your_agent_shared_secret_here
